{
  "name": "little-writer-forest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "小笔苗 · 作文森林 —— 小学生看图作文 + 语音录入 + AI 点评 + 段位成长 App（Web / 手机浏览器 / 安卓 APK）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4190",
    "lint": "tsc -b --noEmit && eslint .",
    "test": "vitest run --config vitest.config.ts",
    "inbox:check": "vitest run --config vitest.config.ts scripts/inbox-verify.test.ts",
    "inbox:photo": "node scripts/inbox-photo.mjs",
    "fixture:webm": "node scripts/mk-speech-fixture.mjs",
    "probe:volc": "node scripts/_probe-volcengine.mjs",
    "probe:volc:stream": "node scripts/_probe-volcengine-stream.mjs",
    "verify:device": "node scripts/verify-device.mjs",
    "test:watch": "vitest --config vitest.config.ts",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "apk": "bash scripts/build-apk.sh",
    "apk:release": "bash scripts/build-apk.sh release",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
